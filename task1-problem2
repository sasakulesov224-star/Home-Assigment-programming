def solve_floyd(n, tariffs):
    INF = 999999
    
    d = [[INF] * n for _ in range(n)]
    
    for i in range(n):
        for j in range(n):
            if i == j:
                d[i][j] = 0
            elif tariffs[i][j] != -1:
                d[i][j] = tariffs[i][j]
    
    for k in range(n):
        for i in range(n):
            for j in range(n):
                if d[i][k] < INF and d[k][j] < INF:
                    d[i][j] = min(d[i][j], d[i][k] + d[k][j])
    
    res = []
    for i in range(n):
        row = []
        for j in range(n):
            if d[i][j] == INF:
                row.append(-1)
            else:
                row.append(d[i][j])
        res.append(row)
    
    return res
